{
  "name": "jared-dev",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.17.0",
  "engines": {
    "node": "26.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/migrate-deploy.mjs && next build",
    "start": "next start",
    "lint": "eslint && node scripts/check-migrations.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "view-logs": "tsx --env-file=.env --env-file-if-exists=.env.local scripts/view-logs.ts",
    "list-blocks": "tsx --env-file=.env --env-file-if-exists=.env.local scripts/list-blocks.ts",
    "unblock": "tsx --env-file=.env --env-file-if-exists=.env.local scripts/unblock.ts",
    "usage-stats": "tsx --env-file=.env --env-file-if-exists=.env.local scripts/usage-stats.ts",
    "private:upload": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/private-sync.ts upload",
    "private:download": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/private-sync.ts download",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=.env --env-file-if-exists=.env.local node_modules/drizzle-kit/bin.cjs migrate",
    "db:studio": "node --env-file-if-exists=.env --env-file-if-exists=.env.local node_modules/drizzle-kit/bin.cjs studio",
    "audit": "tsx scripts/lighthouse-audit.ts",
    "prepare": "husky"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.135.0",
    "@mantine/core": "^9.7.2",
    "@mantine/hooks": "^9.7.2",
    "@mozilla/readability": "^0.6.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "drizzle-orm": "0.45.4",
    "linkedom": "^0.18.13",
    "mammoth": "^1.13.0",
    "next": "^16.4.2",
    "pg": "8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "unpdf": "^1.9.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@types/node": "^26.6.5",
    "@types/pg": "8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "chrome-launcher": "1.2.2",
    "drizzle-kit": "0.31.11",
    "eslint": "^10.13.0",
    "eslint-config-next": "^16.4.2",
    "husky": "^9.1.7",
    "lighthouse": "^13.5.0",
    "postcss-preset-mantine": "^1.18.0",
    "postcss-simple-vars": "^7.0.1",
    "tsx": "^4.23.15",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "^5.0.5"
  }
}

# Sync the gitignored private files to the live site on every push.
#
# PROFILE_BRIEF.md (comp floor and other internal material) and
# resume.pdf (email + phone) stay out of this public repo; production
# reads them from Postgres. This uploads local edits (files unchanged
# since the last sync send nothing). If another machine pushed a newer
# copy since, the upload is refused rather than overwriting it.
#
# Never blocks the push: the endpoint may not be deployed yet (first
# push of a branch that adds it), or the site may be briefly down. Run
# `pnpm run private:upload` by hand if it warns.
if [ ! -f PROFILE_BRIEF.md ] && [ ! -f resume.pdf ]; then
  exit 0
fi

pnpm run --silent private:upload || echo "[pre-push] private:upload failed (push continues). Re-run it by hand once the site is up."
exit 0
